<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>ZaptecMonitor</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Product>Zaptec Monitor</Product>
    <Copyright>Copyright © 2026 Per Hejndorf</Copyright>
    <!-- The version is set in Directory.Build.props. -->
    <!-- Velopack's Program.Main replaces the generated WPF entry point -->
    <StartupObject>ZaptecMonitor.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.3.39-g8d2844f" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Zaptec.Api\Zaptec.Api.csproj" />
    <ProjectReference Include="..\Stromligning\Stromligning.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
