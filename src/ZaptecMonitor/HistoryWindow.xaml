<Window x:Class="ZaptecMonitor.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Charge history" Width="600" Height="640" MinWidth="500" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackground}">
    <DockPanel Margin="16">
        <!-- Range -->
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="ChargerText" FontSize="13" Foreground="{StaticResource MutedText}" />
            <TextBlock Text="Energy charged per hour, and what it cost" FontSize="20" FontWeight="SemiBold" Margin="0,2,0,10" />

            <WrapPanel>
                <StackPanel Margin="0,0,10,6">
                    <TextBlock Text="From" Style="{StaticResource Caption}" />
                    <DatePicker x:Name="FromPicker" Width="120" SelectedDateFormat="Short" />
                </StackPanel>
                <StackPanel Margin="0,0,10,6">
                    <TextBlock Text="To" Style="{StaticResource Caption}" />
                    <DatePicker x:Name="ToPicker" Width="120" SelectedDateFormat="Short" />
                </StackPanel>
                <Button x:Name="LoadButton" Content="Show" Width="80" Height="26" VerticalAlignment="Bottom"
                        Margin="0,0,0,6" IsDefault="True" Click="Load_Click" Style="{StaticResource AccentButton}" />
            </WrapPanel>

            <WrapPanel Margin="0,2,0,10">
                <WrapPanel.Resources>
                    <Style TargetType="Button">
                        <Setter Property="Padding" Value="8,2" />
                        <Setter Property="Margin" Value="0,0,6,0" />
                    </Style>
                </WrapPanel.Resources>
                <Button Content="Last 7 days" Tag="7" Click="Preset_Click" />
                <Button Content="Last 30 days" Tag="30" Click="Preset_Click" />
                <Button Content="This month" Tag="month" Click="Preset_Click" />
                <Button Content="Last month" Tag="lastmonth" Click="Preset_Click" />
            </WrapPanel>
        </StackPanel>

        <!-- Footer -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button x:Name="ExportButton" DockPanel.Dock="Right" Content="Export CSV…" Padding="10,3"
                    Click="Export_Click" IsEnabled="False" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TotalText" FontSize="14" FontWeight="SemiBold" />
                <TextBlock x:Name="CostText" FontSize="13" Visibility="Collapsed" Margin="0,1,0,1" />
                <TextBlock x:Name="StatusText" FontSize="11" Foreground="{StaticResource MutedText}" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>

        <!-- Table -->
        <Border Style="{StaticResource Card}" Padding="0">
            <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEEEF0"
                      BorderThickness="0" Background="Transparent" RowBackground="Transparent"
                      AlternatingRowBackground="#F8F8FA" CanUserResizeRows="False" SelectionMode="Extended"
                      ClipboardCopyMode="IncludeHeader" FontSize="13">
                <DataGrid.Resources>
                    <Style x:Key="Header" TargetType="DataGridColumnHeader">
                        <Setter Property="Padding" Value="10,6" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Background" Value="White" />
                        <Setter Property="BorderBrush" Value="#E3E3E6" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                    </Style>
                    <Style x:Key="NumberHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource Header}">
                        <Setter Property="HorizontalContentAlignment" Value="Right" />
                    </Style>
                    <Style x:Key="NumberCell" TargetType="TextBlock">
                        <Setter Property="HorizontalAlignment" Value="Right" />
                    </Style>
                </DataGrid.Resources>
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource Header}" />
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="10,4" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#D7EEE3" />
                                <Setter Property="Foreground" Value="Black" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="*" />
                    <DataGridTextColumn Header="Hour" Binding="{Binding Hour}" Width="110" />
                    <DataGridTextColumn Header="kWh" Binding="{Binding Kwh}" Width="75"
                                        HeaderStyle="{StaticResource NumberHeader}" ElementStyle="{StaticResource NumberCell}" />
                    <DataGridTextColumn x:Name="PriceColumn" Header="kr/kWh" Binding="{Binding Price}" Width="75"
                                        HeaderStyle="{StaticResource NumberHeader}" ElementStyle="{StaticResource NumberCell}" />
                    <DataGridTextColumn x:Name="CostColumn" Header="kr" Binding="{Binding Cost}" Width="80"
                                        HeaderStyle="{StaticResource NumberHeader}" ElementStyle="{StaticResource NumberCell}" />
                    <DataGridTextColumn Header="" Binding="{Binding Note}" Width="34" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</Window>
