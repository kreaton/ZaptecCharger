<Window x:Class="ZaptecMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zaptec Charger" Width="420" Height="500"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Background="{StaticResource WindowBackground}">
    <Grid Margin="20,14,20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- header -->
            <RowDefinition Height="Auto" />  <!-- status -->
            <RowDefinition Height="Auto" />  <!-- stats card -->
            <RowDefinition Height="Auto" />  <!-- schedule -->
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />  <!-- buttons -->
            <RowDefinition Height="Auto" />  <!-- footer -->
            <RowDefinition Height="Auto" />  <!-- poll progress -->
        </Grid.RowDefinitions>

        <!-- Header: charger name + refresh + settings -->
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="RefreshButton" Style="{StaticResource IconButton}" Content="&#xE72C;"
                        ToolTip="Refresh now (F5)" Click="RefreshButton_Click" IsEnabled="False" />
                <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Content="&#xE713;"
                        ToolTip="Settings (Ctrl+,)" Click="SettingsButton_Click" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="OnlineDot" Width="9" Height="9" Fill="LightGray" Margin="0,1,8,0"
                         VerticalAlignment="Center" />
                <TextBlock x:Name="ChargerName" Text="Connecting…" FontSize="14"
                           Foreground="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DockPanel>

        <TextBlock x:Name="StatusText" Grid.Row="1" Text="–" FontSize="26" FontWeight="SemiBold"
                   Margin="0,6,0,12" TextWrapping="Wrap" />

        <!-- Stats card -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="POWER" Style="{StaticResource Caption}" />
                    <TextBlock x:Name="PowerText" Text="–" FontSize="20" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="THIS SESSION" Style="{StaticResource Caption}" />
                    <TextBlock x:Name="EnergyText" Text="–" FontSize="20" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Schedule -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="12,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="&#xE823;" FontFamily="{StaticResource IconFont}"
                           FontSize="16" VerticalAlignment="Top" Margin="0,1,10,0"
                           Foreground="{StaticResource MutedText}" />
                <StackPanel>
                    <TextBlock x:Name="ScheduleText" Text="Schedule off" FontSize="13" TextWrapping="Wrap" />
                    <TextBlock x:Name="ScheduleDetail" FontSize="12" Foreground="{StaticResource MutedText}"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Why Start / Pause are (not) available right now -->
        <DockPanel Grid.Row="4" VerticalAlignment="Bottom" Margin="2,12,2,0">
            <TextBlock DockPanel.Dock="Left" Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="13"
                       Foreground="{StaticResource MutedText}" Margin="0,2,8,0" VerticalAlignment="Top"
                       x:Name="HintIcon" Visibility="Collapsed" />
            <TextBlock x:Name="HintText" FontSize="12" Foreground="{StaticResource MutedText}" TextWrapping="Wrap" />
        </DockPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,10">
            <Button x:Name="StartButton" Content="Start" Width="130" Height="36" Margin="0,0,10,0"
                    IsEnabled="False" Click="StartButton_Click" Style="{StaticResource AccentButton}"
                    ToolTipService.ShowOnDisabled="True" />
            <Button x:Name="StopButton" Content="Pause" Width="130" Height="36"
                    IsEnabled="False" Click="StopButton_Click" ToolTipService.ShowOnDisabled="True" />
        </StackPanel>

        <DockPanel Grid.Row="6">
            <TextBlock x:Name="PollText" DockPanel.Dock="Right" FontSize="11" Foreground="{StaticResource MutedText}"
                       Margin="8,0,0,0" />
            <TextBlock x:Name="FooterText" FontSize="11" Foreground="{StaticResource MutedText}"
                       TextWrapping="Wrap" />
        </DockPanel>

        <ProgressBar x:Name="PollProgress" Grid.Row="7" Height="3" Margin="0,6,0,0" Minimum="0" Maximum="1"
                     BorderThickness="0" Background="#E6E6E6" Foreground="{StaticResource Accent}" />
    </Grid>
</Window>
